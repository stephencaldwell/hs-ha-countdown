{
  "name": "hs-ha-countdown",
  "version": "1.0.0",
  "description": "Home Screens plugin: a countdown to a Home Assistant timestamp sensor",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite build && (vite build --watch & npx -y serve@latest . -l 5173 --cors --no-clipboard)",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && scripts/pack.sh"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
